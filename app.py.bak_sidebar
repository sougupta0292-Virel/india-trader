            _fut_banner_html += (
                f'<div style="background:#dde9ff;border-radius:8px;padding:5px 10px;font-family:JetBrains Mono">'
                f'<span style="color:#5a72a0;font-size:9px">{_tf.upper()}</span>'
                f'<span style="color:#1d4ed8;font-weight:700;font-size:12px;margin-left:6px">{len(_strats)} strategies</span>'
                f'</div>'
            )
        _fut_banner_html += '</div>'
        st.markdown(_fut_banner_html, unsafe_allow_html=True)

        if not POS_OK:
            st.error("pos_auto_trader.py not found. Check installation.")
        else:
            _fat_inst = st.selectbox("Index", NSE_INDICES, key="fut_inst")
            _fat_tf   = st.selectbox("Timeframe", ["5M","15M","1H","4H"], key="fut_tf")
            _fat_qty  = st.number_input("Lot Qty", value=NSE_LOT_SIZE.get(_fat_inst, 75), step=1, key="fut_qty")
            _fat_paper= st.toggle("Paper Trade", value=True, key="fut_paper")

            _fst_key = f"{_fat_inst}_{_fat_tf}"
            try:
                _fst = POSState.load(_fst_key)
            except Exception:
                from dataclasses import asdict
                _fst = POSState()

            _fsc = {"RUNNING":"#16a34a","STOPPED":"#dc2626","PAUSED":"#d97706"}.get(_fst.status,"#64748b")
            st.markdown(
                f'<div style="background:#fff;border:2px solid {_fsc};border-radius:10px;'
                f'padding:14px;font-family:JetBrains Mono;margin-bottom:10px">'
                f'<div style="color:{_fsc};font-size:16px;font-weight:700">{"RUNNING" if _fst.status=="RUNNING" else "STOPPED" if _fst.status=="STOPPED" else "PAUSED"}'
                f' — {_fst_key}</div>'
                f'<div style="color:#5a72a0;font-size:11px;margin-top:4px">'
                f'Last scan: {_fst.last_scan or "—"} | Signal: {_fst.last_signal} | Action: {_fst.last_action}</div>'
                f'</div>',
                unsafe_allow_html=True)

            _fb1, _fb2 = st.columns(2)
            with _fb1:
                if st.button("Start Futures Bot", type="primary", use_container_width=True, key="fut_start"):
                    try:
                        _ftrader = POSAutoTrader(
                            instrument=_fat_inst, timeframe=_fat_tf,
                            qty=int(_fat_qty), paper_trade=_fat_paper
                        )
                        _ftrader.start()
                        st.session_state.pos_trader = _ftrader
                        st.success(f"Started {_fst_key}!"); st.rerun()
                    except Exception as _fe:
                        st.error(f"Error: {_fe}")
            with _fb2:
                if st.button("Stop Futures Bot", use_container_width=True, key="fut_stop"):
                    if st.session_state.pos_trader:
                        try: st.session_state.pos_trader.stop()
                        except: pass
                    try:
                        _fst2 = POSState.load(_fst_key)
                        _fst2.status = "STOPPED"
                        _fst2.log_msg("Stopped via dashboard")
                        _fst2.save(_fst_key)
                    except: pass
                    st.rerun()

            # Activity log
            if _fst.log:
                st.markdown("**Activity Log**")
                _flog_html = '<div style="background:#f8faff;border:1px solid #dde9ff;border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;font-family:JetBrains Mono;font-size:10px">'
                for _fle in reversed(_fst.log[-30:]):
                    _flog_html += f'<div style="color:#1e293b;padding:1px 0">{_fle}</div>'
                _flog_html += '</div>'
                st.markdown(_flog_html, unsafe_allow_html=True)

            # History
            if _fst.history:
                st.markdown("**Recent Trades**")
                _fhist_rows = []
                for _fht in reversed(_fst.history[-20:]):
                    if isinstance(_fht, dict):
                        _fhist_rows.append({
                            "Date": _fht.get('date',''), "Time": _fht.get('time',''),
                            "Dir": _fht.get('direction',''), "Strategy": _fht.get('strategy',''),
                            "Entry ₹": f"₹{float(_fht.get('entry',0)):,.0f}",
                            "Exit ₹": f"₹{float(_fht.get('exit_price',0)):,.0f}",
                            "P&L ₹": f"₹{float(_fht.get('pnl_rs',0)):+,.0f}",
                            "Reason": _fht.get('exit_reason',''),
                        })
                if _fhist_rows:
                    st.dataframe(pd.DataFrame(_fhist_rows), use_container_width=True, hide_index=True)

