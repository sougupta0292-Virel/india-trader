                _olog_html = '<div style="background:#f8faff;border:1px solid #dde9ff;border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;font-family:JetBrains Mono;font-size:10px">'
                for _ole in reversed(_ost2.log[-30:]):
