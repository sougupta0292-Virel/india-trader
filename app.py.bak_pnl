    _sb_paper_lbl = "PAPER (simulated)" if _sb_paper else "LIVE (real orders via Angel One)"
    st.markdown(f'<div style="font-family:JetBrains Mono;font-size:10px;color:{_sb_paper_c};margin-bottom:4px">{_sb_paper_lbl}</div>', unsafe_allow_html=True)
    st.markdown('<div style="font-size:10px;color:#64748b;margin-top:-4px">Options always paper trade</div>', unsafe_allow_html=True)

    # ── Active Timeframes ─────────────────────────────────────────────────────
