    _all_ind_bots.update(st.session_state.get('ind_fut_bots', {}))
    _all_ind_bots.update(st.session_state.get('ind_opt_bots', {}))
    _ind_tf_status = {
        "5M":  any("_5M" in k for k in _all_ind_bots),
        "15M": any("_15M" in k for k in _all_ind_bots),
        "1H":  any("_1H" in k for k in _all_ind_bots),
        "4H":  any("_4H" in k for k in _all_ind_bots),
    }
    _ind_tf_strats = {
        "5M":  ["ORB Breakout","5 EMA Cross","VWAP Bounce","PPT Fibonacci","Gap Fill","Tail Reversal","VWAP Reclaim"],
        "15M": ["ORB 15M","EMA Pullback","Bollinger Squeeze","Support Bounce","Inside Candle","VWAP CPR"],
        "1H":  ["EMA Trend","Momentum Swing","RSI Divergence","Breakout Momentum","Mean Reversion"],
        "4H":  ["Swing EMA","Fib Swing","RSI Reversal","Trend Continuation","Cup & Handle"],
    }
    _all_tf_running = all(_ind_tf_status.values())
    if _all_tf_running:
        st.markdown(
            '<div style="background:#f0fdf4;border:1px solid #86efac;border-radius:6px;'
            'padding:4px 10px;font-family:JetBrains Mono;font-size:10px;color:#15803d;'
            'font-weight:700;text-align:center;margin-bottom:6px">ALL TIMEFRAMES RUNNING</div>',
            unsafe_allow_html=True)
    for _itfk, _itfon in _ind_tf_status.items():
        _idotc = "#16a34a" if _itfon else "#dc2626"
        _ilbl  = "RUNNING" if _itfon else "STOPPED"
        _ibg   = "#f0fdf4" if _itfon else "#fff1f2"
        _ibc   = "#86efac" if _itfon else "#fca5a5"
        st.markdown(
            f'<div style="background:{_ibg};border:1px solid {_ibc};border-radius:6px;'
            f'padding:5px 10px;margin-bottom:3px;display:flex;justify-content:space-between;align-items:center">'
            f'<span style="font-family:JetBrains Mono;font-size:12px;font-weight:700">'
            f'<span style="color:{_idotc}">&#9679;</span> {_itfk}</span>'
            f'<span style="font-size:10px;color:{_idotc};font-family:JetBrains Mono">{_ilbl}</span></div>',
            unsafe_allow_html=True)
        _isnames = _ind_tf_strats.get(_itfk, [])
        st.markdown(
            '<div style="font-size:9px;color:#64748b;font-family:JetBrains Mono;'
            f'padding:1px 10px 4px 22px">{" * ".join(_isnames)}</div>',
            unsafe_allow_html=True)

    st.markdown("---")
    if st.button("Refresh All Data", type="primary", use_container_width=True):
        with st.spinner("Fetching NSE data..."):
            for _sym in NSE_INDICES:
                _ld = fetch_nse_live_data(_sym)
                if _ld and _sym == "NIFTY":
                    st.session_state.spot       = _ld['spot']
                    st.session_state.prev_high  = _ld['prev_high']
                    st.session_state.prev_low   = _ld['prev_low']
                    st.session_state.prev_close = _ld['prev_close']
                    st.session_state.day_high   = _ld.get('day_high', _ld['spot']*1.01)
                    st.session_state.day_low    = _ld.get('day_low',  _ld['spot']*0.99)
        if STRATEGY_ENGINE_OK:
            try:
                cues = GlobalCuesEngine.fetch_global_cues()
                gb, gs, _ = GlobalCuesEngine.compute_global_bias(cues)
                st.session_state.global_bias  = gb
                st.session_state.global_score = gs
                st.session_state.cues         = cues
            except Exception: pass
        st.success(f"Refreshed! Nifty: Rs{st.session_state.spot:,.0f}")
        st.rerun()

    # Auto-connect Angel One if market open and env keys set
    if _mkt_open and not st.session_state.angel_connected and os.getenv('ANGEL_API_KEY'):
        try:
            _ac = AngelOneClient(
                api_key=os.getenv('ANGEL_API_KEY',''),
                client_id=os.getenv('ANGEL_CLIENT_ID',''),
                mpin=os.getenv('ANGEL_MPIN',''),
                totp_key=os.getenv('ANGEL_TOTP_KEY','')
            )
            _aok, _ = _ac.connect()
            if _aok:
                st.session_state.angel_client    = _ac
                st.session_state.angel_connected = True
                st.session_state.angel_funds     = _ac.get_funds()
        except Exception: pass


