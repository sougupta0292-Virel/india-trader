# ── Load env ───────────────────────────────────────────────────────────────────
def _load_env():
    for name in ['.env', '.env.txt']:
        ep = os.path.join(_APP_DIR, name)
        if os.path.exists(ep):
            with open(ep) as f:
                for line in f:
                    line = line.strip()
                    if line and '=' in line and not line.startswith('#'):
                        k, _, v = line.partition('=')
                        os.environ[k.strip()] = v.strip()
_load_env()

